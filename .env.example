# --- Órarend: környezeti változók -------------------------------------------
# Egyik sem kötelező a fejlesztéshez: nélkülük az app elindul és kirajzolja az
# órarendet, csak a statisztika és az értesítések maradnak némák.

# Használati számláló + az értesítés-feliratkozások tárolója.
# Vercel marketplace → Upstash Redis (a `REDIS_KV_*` nevek az integrációtól jönnek).
REDIS_KV_REST_API_READ_ONLY_TOKEN="example"
REDIS_KV_REST_API_TOKEN="example"
REDIS_KV_REST_API_URL="https://example.upstash.io"
REDIS_KV_URL="rediss://default:example@example.upstash.io:6379"
REDIS_URL="rediss://default:example@example.upstash.io:6379"

# A /statisztika jelszava és a GET /api/hasznalat kulcsa. `openssl rand -hex 24`
STATS_KEY="example"

# --- Push értesítések --------------------------------------------------------
# VAPID kulcspár. Generálás: `bunx web-push generate-vapid-keys`
# A NYILVÁNOS fele bekerül a kliens kódjába — ez nem titok, ez a feliratkozás
# egyik bemenete. A PRIVÁT fele MAGA A KÜLDÉS JOGA: aki megszerzi, a te nevedben
# tud értesítést tenni a diákok telefonjára. Soha ne kerüljön a repóba.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="example"
VAPID_PRIVATE_KEY="example"
# Elérhetőség a push-szolgáltatóknak (mailto: vagy https://).
VAPID_SUBJECT="mailto:pelda@example.com"

# Az ütemezett feladat (`/api/ertesites/tick`) kulcsa. A Vercel Cron
# `Authorization: Bearer $CRON_SECRET` fejlécben küldi. Kulcs nélkül a végpont
# 404-et ad, tehát a létezése sem derül ki. `openssl rand -hex 24`
CRON_SECRET="example"

# --- Bejelentkezés + beállítás-szinkron (opcionális) -------------------------
# Enélkül az app teljesen működik: csak a belépés gomb marad el, és a
# beállítások eszközönként külön élnek (mint eddig).
#
# Adatbázis (Postgres). Ide KIZÁRÓLAG a fiókok, a munkamenetek és a
# beállítás-csomagok kerülnek — órarendadat soha.
DB_URL="postgresql://user:pass@host:5432/orarend"
# A SÉMAMÓDOSÍTÁS (`bun run db:push`) NEM MEHET POOLEREN. A pgbouncer tranzakciós
# módjában a Prisma session-szintű advisory lockja nem szerezhető meg, és a
# parancs nem hibázik, hanem VÉGTELENÜL VÁR. Neonnál ez ugyanaz a cím, `-pooler`
# nélkül. Nem poololt adatbázisnál elhagyható.
DB_DIRECT_URL="postgresql://user:pass@host-direct:5432/orarend"

# A munkamenet-sütik aláírása. `openssl rand -base64 32`
# A csere MINDENKIT kijelentkeztet — ez a szándékolt viselkedés, ha kiszivárgott.
BETTER_AUTH_SECRET="example"
# Az app kanonikus címe. Ebből származik a passkey-k Relying Party ID-ja is,
# ezért a MEGVÁLTOZTATÁSA minden meglévő passkey-t érvénytelenít.
BETTER_AUTH_URL="http://localhost:3000"

# --- Iskolai bejelentkezés ---------------------------------------------------
# NINCS hozzá külön kulcs vagy titok: a belépés a Jedlikinfo nyilvános
# bejelentkező végpontját hívja (https://jedlikinfo.jedlik.eu/api/api/login), és
# a diák saját felhasználónevét/jelszavát adja tovább neki. A jelszó sehol nem
# áll meg nálunk — lásd src/lib/jedlik-ad.ts.
#
# Ebből következik, hogy a bejelentkezés a fenti DB_URL + BETTER_AUTH_SECRET
# meglétén kívül semmit nem igényel. Ha az adatbázis nincs beállítva, a lap
# ugyanúgy működik, csak a belépés hibázik.
