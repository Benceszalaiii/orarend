//! ─── AZ ADATBÁZIS SÉMÁJA ────────────────────────────────────────────────────
//! Ez a séma a bejelentkezést, a beállítás-szinkront, a diák saját, órához
//! kötött linkjeit / kivetítő-címeit, valamint a szakköröket és a versenyeket
//! szolgálja ki.
//! Az órarend adata NEM kerül ide: az a Jedlikinfóé, mi csak megjelenítjük. A
//! használati statisztika és a push-feliratkozások továbbra is a Redisben élnek
//! (`lib/usage-store.ts`, `lib/push-store.ts`) — azok NÉVTELENEK, és nem szabad,
//! hogy egy fiókhoz köthetővé váljanak pusztán attól, hogy most már van fiók.
//!
//! A táblaneveket a Better Auth adja (`@@map`); a mezőket a
//! `bun run db:generate` fordítja klienssé.

generator client {
  provider = "prisma-client"
  output   = "./generated/"
}

datasource db {
  provider = "postgresql"
}

//! ─── FELHASZNÁLÓ ────────────────────────────────────────────────────────────
//! NINCS REGISZTRÁCIÓ. Egy sor kizárólag akkor születik, ha valaki sikeresen
//! bejelentkezett az ISKOLAI rendszerbe (Jedlikinfo / Active Directory) — a
//! fiókot nem mi hozzuk létre, hanem a suli rendszere IGAZOLJA, és mi ebből
//! származtatunk egy helyi sort.
//!
//! A JELSZÓ ÁTFOLYIK, DE SEHOL NEM ÁLL MEG. A belépéskor a szerverünk
//! továbbítja az iskolai API-nak, és ott véget is ér az útja: nem tároljuk,
//! nem kivonatoljuk és nem naplózzuk. Ezért nincs `password` mező a
//! felhasználón, és ezért nem szabad soha bekapcsolni az `emailAndPassword`
//! ágat (lásd `src/lib/auth.ts`) — az ugyanis a MI jelszavunkat tárolná, és
//! ezzel egy második, gyengébb bejárat nyílna ugyanahhoz a fiókhoz.
model User {
  id String @id

  //* A megjelenítendő név. Ha az iskolai válasz ad nevet, azt vesszük át; ha
  //* nem, a felhasználónév marad. Sose találgatunk belőle keresztnevet: az
  //* iskolai fiókok névsémája nem megbízható.
  name String

  //! AZ E-MAIL SZINTETIKUS, ÉS EZ SZÁNDÉKOS. A Better Auth egyedi e-mailt vár
  //! minden felhasználóra, az iskolai bejelentkezés viszont nem ad megbízható
  //! címet. Ezért `<felhasználónév>@jedlik-ad.invalid` kerül ide: a `.invalid`
  //! az RFC 2606 szerint SOHA nem létező tartomány, tehát erre a címre levelet
  //! küldeni technikailag lehetetlen — nem tudunk véletlenül sem kispamelni
  //! senkit, és valódi iskolai e-mail-cím sem szivárog ki innen.
  //!
  //! EBBŐL KÖVETKEZIK: e-mailes folyamatot (jelszó-emlékeztető, cím-igazolás)
  //! ezen az appon SOHA nem szabad bekapcsolni — a levél a semmibe menne.
  email         String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //! ─── AZ ISKOLAI AZONOSSÁG ────────────────────────────────────────────────
  //! Ezeket a mezőket KIZÁRÓLAG a szerver írja, az iskolai válaszból. A kliens
  //! soha nem küldheti be őket — enélkül bárki tanárrá vagy más osztály tagjává
  //! tehetné magát egy `/update-user` hívással (az a végpont emiatt is zárva
  //! van, lásd `src/lib/auth.ts`).

  //* Az iskolai felhasználónév kisbetűsítve — ennek a mezőnek AZ AD-BELÉPÉS AD
  //* értéket. Egyedi: egy iskolai AD-fiókhoz pontosan egy helyi fiók
  //* tartozhat.
  //!
  //! `null`-LAL ENGEDÉLYEZETT (Postgres az egyedi indexben több `NULL`-t is
  //! megenged): egy Google-fiókkal érkező felhasználónak nincs AD
  //! felhasználóneve, és nem is találgatunk rá egyet az e-mail helyi
  //! részéből — az összefűzés/import erre a `link-social` folyamat vagy egy
  //! külön migrációs script, nem ez a mező (lásd `src/lib/auth.ts`).
  username String? @unique

  //* Ugyanaz, ahogy a diák beírta (nagybetűkkel együtt) — csak megjelenítésre.
  displayUsername String?

  //! AZ OSZTÁLY — EZÉRT ÉRI MEG EGYÁLTALÁN AZ ISKOLAI BELÉPÉS. Ezt az adatot
  //! semmilyen külső azonosító (Google, Microsoft) nem adja meg: csak a suli
  //! saját rendszere tudja, ki melyik osztályba jár. Belépés után a lap ebből
  //! tudja azonnal a helyes órarendet, találgatás és kézi beállítás nélkül.
  //* `null` = tanár, vagy az iskolai válasz nem adta meg.
  class String?

  //! `false` az alapértelmezés. AD-belépésnél a mezőt CSAK akkor írjuk felül,
  //! ha az iskolai válasz ténylegesen nyilatkozott róla (lásd
  //! `src/lib/jedlik-ad.ts`) — hiányzó adatból nem minősítünk vissza senkit
  //! tanárból diákká.
  //!
  //! GOOGLE-BELÉPÉSNÉL A DOMAIN NEM ELÉG. A `@students.jedlik.eu` diák, de a
  //! `@jedlik.eu` címen nem csak tanárok ülnek: ott a Google-névnek szerepelnie
  //! kell a Jedlikinfo tanárlistájában is (`src/lib/teacher-directory.ts`).
  //! Minden Google-fiókos munkamenet-létrehozáskor újraértékelődik; ha a lista
  //! épp nem elérhető, a mező érintetlen marad.
  isTeacher Boolean @default(false)

  //* A tanár neve PONTOSAN úgy, ahogy a Jedlikinfo tanárlistájában áll (nem a
  //* Google-név) — ez a stabil kulcs a saját tanári órarendhez
  //* (`resolveTeacher` a `timetable.ts`-ben név szerint is felold).
  //* `null` = nem tanár, vagy még nem azonosítottuk.
  teacherName String?

  //* Mikor néztük meg utoljára az iskolai rendszerben, hogy az osztály és a
  //* tanár-státusz stimmel-e. Minden jelszavas belépés frissíti; a passkey-s
  //* belépés NEM (ott nincs jelszó, amit az iskola felé továbbadhatnánk).
  adCheckedAt DateTime?

  //! ─── A VÁLASZTOTT TWEAKCN-PRESET ─────────────────────────────────────────
  //! MIÉRT NEM A `Preference.data`-BAN, A TÖBBI BEÁLLÍTÁSSAL. Az a JSON a
  //! KÉSZÜLÉKEK KÖZÖTT vándorol: a böngésző írja, a szerver átlátszó
  //! tárolóként veszi át (`src/lib/prefs-shared.ts`). A preset viszont a
  //! SZERVEREN dől el — abból lesz a lapba ágyazott `<style>`, még a
  //! renderelés közben —, és olyan slug kerülhet csak bele, amit a tweakcn
  //! regiszterében ellenőriztünk. Egy saját oszlop ezt kimondja: ez nem a
  //! kliens által küldött adat.
  //* `null` = a `globals.css`-be épített paletta. Ilyenkor nem ágyazunk be
  //* semmit, tehát nincs többletköltsége annak, aki nem választott.
  themePreset String?

  //* A Better Auth infra `activityTracking` bővítménye írja minden
  //* kérésnél — lásd `src/lib/auth.ts`. `null` = még soha nem járt itt.
  lastActiveAt DateTime?

  //! ─── ÜZEMELTETŐI JOG ─────────────────────────────────────────────────────
  //! Egyetlen dolgot nyit: a közlemények kezelését (`/admin`). EGYETLEN KÓDÚT
  //! SEM ÍRJA — sem a belépés, sem a kliens (`input: false`, `src/lib/auth.ts`).
  //! Kézzel kell beállítani az adatbázisban:
  //!   UPDATE "user" SET "isAdmin" = true WHERE email = '…@jedlik.eu';
  isAdmin Boolean @default(false)

  //! KÉZZEL RÖGZÍTETT AZONOSSÁG. Ha igaz, a belépés (AD vagy Google) nem írja
  //! felül az osztályt, a tanár-státuszt és a tanárnevet — az admin pult
  //! (`/admin`) állítja, amikor ezeket kézzel módosítják.
  identityLocked Boolean @default(false)

  //! ─── A BETTER AUTH `admin()` BŐVÍTMÉNY MEZŐI ─────────────────────────────
  //! Lásd `src/lib/auth.ts`. A `role` MÁS, mint az `isAdmin`: `"admin"` érték a
  //! teljes fiókkezelést nyitja (kitiltás, megszemélyesítés) — csak kézzel,
  //! adatbázisból állítható. A kitiltást a Better Auth infra pultja is írja.
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions           Session[]
  accounts           Account[]
  passkeys           Passkey[]
  preference         Preference?
  lessonLinks        LessonLink[]
  screenTaskHosts    ScreenTaskHost[]
  classroomScreens   ClassroomScreen[]
  teacherLessonLinks TeacherLessonLink[]

  clubMemberships     ClubMember[]
  proposedClubs       Club[]             @relation("clubProposer")
  competitionEntries  CompetitionEntry[]
  createdCompetitions Competition[]      @relation("competitionCreator")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  //* Megszemélyesítésnél az üzemeltető `User.id`-ja (`admin()` bővítmény).
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

//! ─── FIÓK-KÖTÉS ────────────────────────────────────────────────────────────
//! Egy sor = egy belépési mód egy felhasználóhoz. Nálunk ez az iskolai fiók
//! (`providerId: "jedlik-ad"`), és az `accountId` a kisbetűsített iskolai
//! felhasználónév. Szándékosan nem az e-mail-cím a kulcs: az nálunk szintetikus.
//!
//! A `password` mező a Better Auth sémájából jön, és NÁLUNK MINDIG `null` MARAD.
//! Az iskolai jelszó a belépéskor csak ÁTFOLYIK a szerveren az iskolai API felé;
//! nincs olyan kódút, ami ebbe az oszlopba írna. Ha valaha érték kerülne ide, az
//! hiba — a jelszó gazdája az iskola, nem mi.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

//! ─── PASSKEY ───────────────────────────────────────────────────────────────
//! A KÉNYELMES ÚT, NEM A BEJÁRAT. A fiók mindig az iskolai belépésből születik;
//! a passkey-t a diák UTÁNA veszi fel, hogy legközelebb ne kelljen begépelnie
//! az iskolai jelszavát — egy ujjlenyomat vagy arcfelismerés elég. Ez nem csak
//! kényelem: minden passkey-s belépés EGGYEL KEVESEBB alkalom, amikor az
//! iskolai jelszó egyáltalán elhagyja a diák fejét.
//!
//! A `publicKey` NYILVÁNOS kulcs: önmagában nem lehet vele belépni, a privát
//! fele az eszközt soha nem hagyja el. A `counter` a klónozás elleni számláló.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

//! ─── SEBESSÉGKORLÁT ────────────────────────────────────────────────────────
//! A Better Auth korlátozója élesben alapból bekapcsolt, DE memóriában tárol.
//! Ez az app serverless-en fut: ott minden hideg indítás ÜRES memóriával kezd,
//! tehát a memóriaszámláló gyakorlatilag nem korlátoz. Ezért
//! `rateLimit.storage: "database"` — és ezért kell ez a tábla.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

//! ─── A SZINKRONIZÁLT BEÁLLÍTÁSOK ───────────────────────────────────────────
//! EZ AZ EGÉSZ BEJELENTKEZÉS OKA. A diák beállításai (osztály, összevont
//! csoportbontások, duális beosztás, utoljára nézett nézet) eddig kizárólag a
//! böngésző `localStorage`-ában éltek: telefonról gépre átülve elölről kezdte.
//!
//! EGY SOR EGY FELHASZNÁLÓHOZ, EGY JSON-BLOB. Nem bontjuk mezőkre, mert a
//! beállítások alakja a felülettel együtt változik, és minden apró UI-döntéshez
//! sémamigrációt kérni túl drága. Cserébe az alakot a SZERVER ellenőrzi, mielőtt
//! beírná (`src/lib/prefs-shared.ts`): ide nem kerülhet olyasmi, amit a kliens
//! szabadon talált ki.
//!
//! AMI SZÁNDÉKOSAN NINCS ITT: a heti órarend helyi példánya
//! (`orarend:week-cache:v1`), a telepítési tipp jelölője és a napi
//! statisztika-jelölő — az első offline tartalék, a másik kettő készülékfüggő;
//! egyiket sincs értelme átvinni másik eszközre.
model Preference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  //* A `SyncedPrefs` alakja (`src/lib/prefs-shared.ts`) JSON-ként.
  data Json

  //! A KONFLIKTUSFELOLDÁS EGYETLEN TÁMPONTJA. Két eszköz ugyanazt a sort írja;
  //! a kliens minden feltöltésnél megmondja, MELYIK verzióra épít. Ha időközben
  //! nagyobb lett, a szerver elutasítja az írást, a kliens pedig előbb letölti
  //! az újat. Enélkül a lassabb eszköz némán felülírná a frissebb beállítást.
  revision Int @default(1)

  updatedAt DateTime @updatedAt

  @@map("preference")
}

//! ─── AZ ÓRÁHOZ KÖTÖTT LINKEK ───────────────────────────────────────────────
//! A diák saját könyvjelzői egy órához: Classroom-kurzus, feladatlap,
//! Teams-csoport. A kulcs a TANÁR + TANTÁRGY, nem az egyes óra — ugyanaz a link
//! minden héten ott van, ahol az a tanár azt a tárgyat tartja.
//!
//! SAJÁT, NEM KÖZÖS. Egy sor egy felhasználóé; más diák nem látja, és nincs is
//! olyan végpont, amin keresztül láthatná (`/api/ora-kiegeszitok`).
//!
//! A kulcsok kisbetűsítve állnak itt (`extrasKey`, `src/lib/lesson-extras.ts`):
//! a tanár jele a diák és a tanár nézetéből más betűzéssel érkezhet.
model LessonLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher   String
  subject   String
  //* Csak `http`/`https` — a szerver ellenőrzi (`sanitizeLinkUrl`).
  url       String
  label     String?
  createdAt DateTime @default(now())

  @@index([userId, teacher, subject])
  @@map("lesson_link")
}

//! ─── A KIVETÍTŐ (SCREENTASK) CÍME ──────────────────────────────────────────
//! A ScreenTask a tanári gépen fut, és a terem helyi hálózatán osztja meg a
//! képernyőt. A cím ezért a TANÁR + TEREM párhoz tartozik: ugyanaz a tanár
//! másik teremben másik gépről (másik IP-ről) vetít.
//!
//! CSAK HELYI HÁLÓZATI CÍM kerülhet ide (`sanitizeScreenHost`) — nyilvános
//! címre a böngésző amúgy sem engedné betölteni a képet.
model ScreenTaskHost {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher   String
  room      String
  host      String
  port      Int      @default(7070)
  updatedAt DateTime @updatedAt

  @@id([userId, teacher, room])
  @@map("screentask_host")
}

//! ─── A TEREM KIVETÍTŐJE — KÖZÖS, A TANÁR ÁLLÍTJA BE ─────────────────────────
//! A `ScreenTaskHost` diákonként külön tárolta a címet: minden diák maga gépelte
//! be ugyanazt az IP-t, minden teremben, minden tanárnál. Ez a tábla ezt váltja:
//! EGY SOR EGY TEREM. A tanári gép a teremben áll — a cím a teremhez tartozik,
//! nem ahhoz, aki épp vetít.
//!
//! BÁRMELYIK TANÁR ÁTÍRHATJA, NEM CSAK AKI FELVETTE. Ha a gép új IP-t kap, az
//! első tanár, aki észreveszi, kijavítja — és onnantól mindenkinek jó. Diák
//! NEM írhatja (`requireTeacher`, `src/lib/classroom-store.ts`).
//!
//! NYILVÁNOS ADAT: a `/api/kozos-kiegeszitok` mindenkinek kiadja, belépés
//! nélkül is. Csak helyi hálózati cím kerülhet ide (`sanitizeScreenHost`), ami
//! az iskola hálózatán kívülről semmit nem ér.
model ClassroomScreen {
  //* A terem jele `extrasKey` alakban (kisbetűs, összevont szóköz).
  room String @id
  host String
  port Int    @default(7070)

  //* Ki írta utoljára. Törölt fióknál `null`, a cím marad — a terem gépe
  //* nem tűnik el attól, hogy a tanár fiókja megszűnt.
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
  @@map("classroom_screen")
}

//! ─── A TANÁR LINKJEI AZ ÓRÁIHOZ ────────────────────────────────────────────
//! Classroom-kurzus, Teams-csoport, feladatlap — amit a TANÁR tesz fel, és az
//! óráján minden diák látja, belépés nélkül is. A diák saját könyvjelzői
//! (`LessonLink`) mellette megmaradnak.
//!
//! CSAK AZ ÓRA SAJÁT TANÁRA ÍRHATJA. A kulcs a tanár JELE; a szerver a belépett
//! tanár nevét a Jedlikinfo tanárlistájában jellé oldja, és csak akkor enged
//! írni, ha az egyezik (`src/lib/classroom-store.ts`).
//!
//! OSZTÁLYRA SZŰKÍTHETŐ. Ugyanaz a tanár ugyanazt a tárgyat több osztálynak
//! tanítja, és osztályonként más a Classroom-kurzus. Üres `classes` = a tárgy
//! minden órája, bármelyik osztályban.
model TeacherLessonLink {
  id      String   @id @default(cuid())
  teacher String
  subject String
  classes String[]
  //* Csak `http`/`https` — a szerver ellenőrzi (`sanitizeLinkUrl`).
  url     String
  label   String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([teacher, subject])
  @@index([createdById])
  @@map("teacher_lesson_link")
}

//! ─── KÖZLEMÉNYEK ───────────────────────────────────────────────────────────
//! Az üzemeltető üzenete a lapon: „a Jedlikinfo nem elérhető", „karbantartás".
//! Az `/admin` írja, a `/api/kozlemenyek` adja ki MINDENKINEK — tehát ide
//! semmi nem kerülhet, ami nem nyilvános.
enum AnnouncementKind {
  //* Sáv a lap tetején; nem zárható be.
  BAR
  //* Buborék, ami addig marad, amíg rá nem kattintanak (a böngésző megjegyzi).
  TOAST
  //* Az egész lapot eltakarja — karbantartás, hibás adat.
  BLOCK
}

enum AnnouncementTone {
  INFO
  WARNING
  ERROR
}

model Announcement {
  id      String           @id @default(cuid())
  kind    AnnouncementKind
  tone    AnnouncementTone @default(INFO)
  title   String?
  message String

  //! MELYIK LAPOKON. `*` = mindenhol; `/orarend` = pontosan az; `/tanari/*` =
  //! az és minden alatta. Az illesztés: `src/lib/announcements.ts`.
  paths String[]

  active   Boolean   @default(true)
  //* Opcionális időablak; `null` = nincs korlát abban az irányban.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("announcement")
}

//! ═══════════════════════════════════════════════════════════════════════════
//! SZAKKÖRÖK
//! ═══════════════════════════════════════════════════════════════════════════
//! MIÉRT KELL EZ EGYÁLTALÁN, HA A JEDLIKINFO TUDJA AZ IDŐPONTOKAT. A szakkörök
//! TÖBBSÉGE ott van a Jedlikinfóban — a terem és a tanár órarendjében, OSZTÁLY
//! NÉLKÜLI kártyaként (üres `rightBottom`). Egy osztály nélküli kártya viszont
//! egyetlen osztály órarendjében sem jelenik meg: a suli tudja, mikor van a
//! szakkör, a diák nem látja. (Ellenőrizve 2026-09-21 hetére: a kiinduló lista
//! 47 szakköréből 39 megvan így, sokszor csak „Tehetséggondozó szakkör" néven.)
//!
//! A FELOSZTÁS EZÉRT: a szakkör KILÉTE (neve, leírása, kinek szól, ki vezeti)
//! itt él, mert a Jedlikinfo ezt nem tudja; az IDŐPONT itt csak VÁRAKOZÁS
//! (`ClubSlot`), amit a teremkereső heti seprése igazol vagy cáfol. Egy
//! elmaradt hét (tanítás nélküli nap) így nem hazudik „van szakkör"-t.
//!
//! A TANÁR A JELÉVEL SZEREPEL, NEM A FIÓKJÁVAL. A szakkört vezető tanárnak nem
//! kell fiókja legyen ahhoz, hogy a szakköre látsszon; a Jedlikinfo jele (`BNM`)
//! stabil, és ugyanez a kulcs a `TeacherLessonLink`-ben is. Belépett tanárnál a
//! `User.teacherName`-ből oldjuk fel a jelet (`src/lib/classroom-store.ts`
//! mintájára), és a jogosultság ezen a jelen múlik (`src/lib/club-access.ts`).

//* A szakkör jellege — a szűréshez és a felirathoz. A felirat magyarul a
//* `src/lib/clubs.ts`-ben él.
enum ClubKind {
  //* szakkör
  CLUB
  //* emelt szintű (érettségi) felkészítő
  EXAM_PREP
  //* versenyfelkészítő
  COMPETITION_PREP
  //* korrepetálás
  TUTORING
  //* felzárkóztató
  CATCH_UP
  //* kompetenciafejlesztés (egy osztálynak szól)
  COMPETENCY
}

enum ClubStatus {
  //! DIÁK JAVASOLTA, TANÁR MÉG NEM HAGYTA JÓVÁ. Ilyenkor NEM nyilvános: egy
  //! diák javaslata attól lesz szakkör, hogy egy tanár vállalja.
  PROPOSED
  ACTIVE
  //* Megszűnt — a lap megmarad (linkek, tagság), de a listákból kiesik.
  ARCHIVED
}

model Club {
  id   String @id @default(cuid())
  //* Az URL-ben (`/szakkorok/<slug>`). Ékezet nélkül — lásd `clubSlug`.
  slug String @unique

  name        String
  description String?    @db.Text
  kind        ClubKind   @default(CLUB)
  status      ClubStatus @default(ACTIVE)

  //! ─── KINEK SZÓL ──────────────────────────────────────────────────────────
  //! Ebből tudja a lap, hogy egy 09A-s diák órarendjére felkerül-e — belépés
  //! nélkül is, pusztán a kiválasztott osztályból. A kettő VAGY kapcsolatban
  //! áll: az évfolyam (`9`) vagy az osztály (`09A`) egyezése elég. Mindkettő
  //! üres = mindenkinek szól (akkor a rácsra nem tesszük ki magától).
  grades       Int[]
  //* Osztálynevek pontosan a Jedlikinfo alakjában (`09A`, `13D`).
  classes      String[]
  //* Amit a két mező nem tud kifejezni, pl. „13D páros, 13E páratlan héten".
  audienceNote String?

  //* Ki javasolta (diák). `null` = tanár vagy admin hozta létre.
  proposedById      String?
  proposedBy        User?     @relation("clubProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  //* Melyik tanár hagyta jóvá a javaslatot (a JELE). Tanári létrehozásnál üres.
  approvedByTeacher String?
  approvedAt        DateTime?

  //! A FRISSESSÉG TÁMPONTJA. Mikor erősítette meg utoljára egy vezető, hogy az
  //! adatok stimmelnek. A Jedlikinfóval igazolt időpontokhoz nem kell (azokat a
  //! heti seprés igazolja); a csak-tanár-szerinti időpontoknál ebből látszik,
  //! mennyire régi az állítás.
  confirmedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizers   ClubOrganizer[]
  slots        ClubSlot[]
  members      ClubMember[]
  //* A versenyfelkészítő szakkör és a verseny, amire készít.
  competitions Competition[]

  @@index([status])
  @@map("club")
}

//! A szakkört vezető tanárok. Több is lehet (Média: HZ és MT). Az első
//! vezetőnél `lead = true` — ő a szakkör arca a listában.
model ClubOrganizer {
  clubId  String
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  //* A Jedlikinfo tanárjele (`looksLikeTeacher`).
  teacher String
  lead    Boolean @default(false)

  @@id([clubId, teacher])
  @@index([teacher])
  @@map("club_organizer")
}

//! HONNAN TUDJUK AZ IDŐPONTOT — ettől függ, mit mondhat a lap, ha egy héten
//! nem találjuk a Jedlikinfóban.
enum ClubSlotSource {
  //* A Jedlikinfóban osztály nélküli kártyaként szerepel. Ha egy héten nincs
  //* ott, a lap azt mondja: „ezen a héten nincs az órarendben".
  TIMETABLE
  //* Csak a vezető tanár szerint van. A lap ezt ki is mondja.
  ORGANIZER
}

//! EGY RENDSZERES IDŐPONT: hét napja + kezdet + vég + terem. Nincs időpontja =
//! a szakkör „egyeztetés alatt" — ezt NEM tároljuk külön, a slotok hiányából
//! következik, így nem csúszhat el egymástól a kettő.
//!
//! PERCBEN, NEM ÓRASZÁMBAN. A Jedlikinfo kártyái percben adják az időt
//! (`startMinuteFromMidnight`), és a szakkörök nem mindig órahatáron kezdenek
//! (Forgácsolás 15:15–16:40). Az órasorszám a megjelenítésé.
model ClubSlot {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  //* 1 = hétfő … 5 = péntek (a Jedlikinfo `dayOfWeek`-je).
  weekday     Int
  startMinute Int
  endMinute   Int
  //* A terem Jedlikinfo-jele (`203`, `B5`, `CNC`, `Stúdió`). `null` = nincs
  //* megadva (csak `ORGANIZER` forrásnál fordulhat elő).
  room        String?
  //! MELYIK VEZETŐ(K) KÁRTYÁJA. Ezzel illesztjük a Jedlikinfo kártyájára
  //! (`leftBottom` a terem órarendjében). A Lego két napja két tanáré, ezért
  //! két slot; a Média egy idősávja két tanáré, ezért egy slot két jellel.
  teachers    String[]
  source      ClubSlotSource @default(TIMETABLE)

  //* Opcionális érvényesség (félévváltás, átszervezés). `null` = nyitott.
  validFrom  DateTime?
  validUntil DateTime?

  @@index([clubId])
  @@index([weekday, room])
  @@map("club_slot")
}

//! A TAGSÁG NYILVÁNOS — a szakkör lapján bárki látja, ki jár oda. Ez döntés,
//! nem mulasztás: a szakkör közösség, és a „ki jár még oda" maga is információ.
model ClubMember {
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([clubId, userId])
  @@index([userId])
  @@map("club_member")
}

//! ═══════════════════════════════════════════════════════════════════════════
//! VERSENYEK
//! ═══════════════════════════════════════════════════════════════════════════
//! ELŐSZÖR CSAK EGYÉNI NEVEZÉS. A csapatok (kapitány, meghívó, névsorzárás)
//! később jönnek; a meghívó akkor is csak alkalmazáson belüli lehet, mert ez az
//! app e-mailt nem tud küldeni (lásd `User.email`).

enum CompetitionCategory {
  PROGRAMMING
  NETWORKING
  ENGINEERING
  MATH
  SCIENCE
  LANGUAGE
  HUMANITIES
  OTHER
}

enum CompetitionStatus {
  //* Szerkesztés alatt, csak a létrehozó látja.
  DRAFT
  //* Nevezés nyitva.
  OPEN
  //* Nevezés lezárva, még nem zajlott le.
  CLOSED
  FINISHED
  CANCELLED
}

enum CompetitionVenue {
  //* Iskolai terem — a `room` a Jedlikinfo-jele.
  SCHOOL
  //* Külső helyszín — a `location` a cím.
  EXTERNAL
  ONLINE
}

model Competition {
  id   String @id @default(cuid())
  //* Az URL-ben (`/versenyek/<slug>`).
  slug String @unique

  name        String
  description String?             @db.Text
  category    CompetitionCategory @default(OTHER)
  status      CompetitionStatus   @default(DRAFT)
  //* A hivatalos oldal (OSZTV, Dusza stb.), ha van. Csak `http`/`https`.
  externalUrl String?

  venue    CompetitionVenue @default(SCHOOL)
  room     String?
  location String?

  startsAt             DateTime
  endsAt               DateTime?
  //! A NEVEZÉSI HATÁRIDŐ AZ, AMIT A DIÁK ELMULASZT. Ezért kap külön mezőt és
  //! külön emlékeztetőt; `null` = a kezdésig lehet nevezni.
  registrationDeadline DateTime?

  //* Ki nevezhet: ugyanaz a VAGY-szabály, mint a `Club`-nál. Üres = mindenki.
  grades   Int[]
  classes  String[]
  //* Létszámkorlát (fő). `null` = korlátlan.
  capacity Int?

  //* A felelős tanár(ok) jele — ők kezelik a nevezéseket.
  teachers String[]

  createdById String?
  createdBy   User?   @relation("competitionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases  CompetitionPhase[]
  entries CompetitionEntry[]
  clubs   Club[]

  @@index([status, startsAt])
  @@map("competition")
}

//! Forduló / határidő: iskolai forduló → országos forduló → döntő.
model CompetitionPhase {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  title         String
  startsAt      DateTime?
  endsAt        DateTime?
  order         Int         @default(0)

  @@index([competitionId, order])
  @@map("competition_phase")
}

model CompetitionEntry {
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([competitionId, userId])
  @@index([userId])
  @@map("competition_entry")
}
